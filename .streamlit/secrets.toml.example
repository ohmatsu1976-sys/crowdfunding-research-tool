# このファイルを secrets.toml にコピーして API キーを設定してください
# secrets.toml は .gitignore に追加してください（公開厳禁）

ANTHROPIC_API_KEY = "sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ブラウザ更新（F5/Ctrl+F5）後もログイン状態を復元するための、永続Cookie
# （auth_cookies.py）の暗号鍵。未設定・不正な値でも通常ログインはクラッシュ
# しないが、ブラウザ更新後の自動ログイン復元だけが無効になる。
# 生成コマンド: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_COOKIE_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="
