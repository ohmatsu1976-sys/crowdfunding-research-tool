-- =============================================================================
-- 0005_admin.sql.example  —  管理者の登録（雛形）
--
-- このファイルは雛形です。実際の user_id を書いた版はリポジトリに置きません。
-- Supabase の SQL Editor で、下の <ここに管理者の user_id> を置き換えて
-- 1回だけ実行してください。
--
-- user_id の調べ方:
--   Supabase 管理画面 → Authentication → Users → 対象アカウントを開く
--   （値はチャットや報告書に貼らないでください）
--
-- 管理者を増やす画面はアプリに作りません。追加も削除もここからだけです。
-- =============================================================================

-- ── 追加 ────────────────────────────────────────────────────────────────────
insert into public.app_admins (user_id, note)
values ('<ここに管理者の user_id>', 'owner')
on conflict (user_id) do nothing;

-- ── 確認（件数だけ。user_id は表示しない）───────────────────────────────────
select count(*) as admins from public.app_admins;

-- ── 取り消したいとき ────────────────────────────────────────────────────────
-- delete from public.app_admins where user_id = '<ここに管理者の user_id>';
